default_platform(:ios)
before_all do
  keychain_name = "new_login.keychain"
  keychain_password = ENV["KEYCHAIN_PASSWORD"]
  
  # 새 키체인이 이미 있으면 생성 오류가 발생할 수 있으므로 rescue 처리
  sh "security create-keychain -p #{keychain_password} #{keychain_name}" rescue nil
  
  # 새 키체인을 기본 키체인으로 설정
  sh "security default-keychain -s #{keychain_name}"
  
  # 새 키체인을 잠금 해제
  sh "security unlock-keychain -p #{keychain_password} #{keychain_name}"
  
  # 키체인 설정(예: 자동 잠금 해제 시간 설정)
  sh "security set-keychain-settings -t 3600 -l ~/Library/Keychains/#{keychain_name}"
end

platform :ios do
  desc "Build and deploy to App Store"
  lane :release do
    # 인증서 및 프로비저닝 처리 (예: match 사용)
    match(
      type: "appstore",
      git_url: "https://github.com/apptcion/key_chain.git",
      git_basic_authorization: Base64.strict_encode64("apptcion:#{ENV['PAT']}"),
      app_identifier: ENV["APP_IDENTIFIER"],
      keychain_name: "new_login.keychain",
      keychain_password: ENV["KEYCHAIN_PASSWORD"],
      readonly: true
    )

    update_project_team(
      path: "DIMI_FRIEND.xcodeproj",
      teamid: "34B6SX46T2"
    )

# 앱 아카이브 빌드
gym(
  project: "DIMI_FRIEND.xcodeproj",
  scheme: "DIMI_FRIEND",
  configuration: "Release",
  export_method: "app-store",
  export_team_id: "34B6SX46T2",
  xcargs: "CODE_SIGNING_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution: sangjeong lee (34B6SX46T2)' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{ENV['APP_IDENTIFIER']}' -allowProvisioningUpdates",
  export_options: {
    provisioningProfiles: {
      ENV["APP_IDENTIFIER"] => "match AppStore #{ENV["APP_IDENTIFIER"]}"
    }
  }
)


    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_content: ENV["FASTLANE_KEY_CONTENT"],
      in_house: false
    )

    # App Store에 업로드 (deliver 사용)
    deliver(
      api_key: api_key,
      ipa: "./build/DIMI_FRIEND.ipa",
      skip_screenshots: true,
      skip_metadata: true
    )
  end
end
